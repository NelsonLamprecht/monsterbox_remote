<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MonsterBoxRemote.Maui.ViewModel"
    x:DataType="viewmodel:MonsterBoxControllerViewModel"
    x:Class="MonsterBoxRemote.Maui.Views.MonsterBoxControllerPage"
    BackgroundColor="{AppThemeBinding Light={StaticResource SpookyGreenLight}, Dark={StaticResource SpookyGreenDark}}"
    Title="MonsterBox Controller">

    <ContentPage.Content>
        <Grid>
            <Grid
                BackgroundColor="#88000000"
                IsVisible="{Binding IsBusy}"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Please Wait..." TextColor="White" HorizontalOptions="Center" />
                    <ActivityIndicator Color="White" IsRunning="True"  />
                </StackLayout>
            </Grid>

            <Grid
                x:Name="DeviceGrid"
                RowSpacing="10"
                Padding="10">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>
                <Grid.ColumnDefinitions>
                    <!-- MonsterBox panel carries 15 buttons vs. Scarecrow's 2,
                         so it gets three times the width instead of an even split. -->
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    x:Name="NavPickerBorder"
                    Grid.Row="0"
                    Grid.RowSpan="1"
                    Grid.ColumnSpan="2"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SpookyPurpleLight}, Dark={StaticResource SpookyPurpleDark}}" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="10">
                    <Picker TextColor="White" FontSize="Medium" BackgroundColor="{AppThemeBinding Light={StaticResource SpookyPurpleLight}, Dark={StaticResource SpookyPurpleDark}}"
                            ItemsSource="{Binding PageList}" ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="PagePicker_SelectedIndexChanged"
                            />
                </Border>
                <!--Left panel: MonsterBox sound/shake controls-->
                <Border
                    x:Name="MonsterBoxPanel"
                    Grid.Column="0"
                    Grid.Row="1"
                    VerticalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SpookyOrangeLight}, Dark={StaticResource SpookyOrangeDark}}" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="10">
                    <Grid RowDefinitions="Auto,*">
                        <Picker
                            Grid.Row="0"
                            TextColor="White" FontSize="Medium" BackgroundColor="{AppThemeBinding Light={StaticResource SpookyPurpleLight}, Dark={StaticResource SpookyPurpleDark}}"
                            ItemsSource="{Binding HostList}" ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="PickerMonsterBox_SelectedIndexChanged"
                        />
                        <Grid Grid.Row="1" RowSpacing="6" ColumnSpacing="6" Margin="0,6,0,0"
                              RowDefinitions="Auto,Auto,*,*,Auto,*"
                              ColumnDefinitions="*,*,*,*,*">
                            <Button
                                Grid.Row="0"
                                Grid.ColumnSpan="5"
                                Text="Shake"
                                Style="{StaticResource ShakeButtonStyle}"
                                HorizontalOptions="Fill"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="shake">
                            </Button>
                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="5"
                                Text="FX"
                                Style="{StaticResource SectionHeaderStyle}" />
                            <Button
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Werewolf"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="werewolf">
                            </Button>
                            <Button
                                Grid.Column="1"
                                Grid.Row="2"
                                Text="Laugh"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="laugh">
                            </Button>
                            <Button
                                Grid.Column="2"
                                Grid.Row="2"
                                Text="Chains"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="chains">
                            </Button>
                            <Button
                                Grid.Column="3"
                                Grid.Row="2"
                                Text="Heartbeat"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="heartbeat">
                            </Button>
                            <Button
                                Grid.Column="4"
                                Grid.Row="2"
                                Text="Dragon Growl"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="dragongrowl">
                            </Button>
                            <Button
                                Grid.Column="0"
                                Grid.Row="3"
                                Text="Door creek"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="doorcreek">
                            </Button>
                            <Button
                                Grid.Column="1"
                                Grid.Row="3"
                                Text="Metal Hit"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="metalhit">
                            </Button>
                            <Button
                                Grid.Column="2"
                                Grid.Row="3"
                                Text="Raven"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="raven">
                            </Button>
                            <Label
                                Grid.Row="4"
                                Grid.ColumnSpan="5"
                                Text="CREATURES"
                                Style="{StaticResource SectionHeaderStyle}" />
                            <Button
                                Grid.Column="0"
                                Grid.Row="5"
                                Text="Creature 1"
                                Style="{StaticResource CreatureButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="creature1">
                            </Button>
                            <Button
                                Grid.Column="1"
                                Grid.Row="5"
                                Text="Creature 2"
                                Style="{StaticResource CreatureButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="creature2">
                            </Button>
                            <Button
                                Grid.Column="2"
                                Grid.Row="5"
                                Text="Creature 3"
                                Style="{StaticResource CreatureButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="creature3">
                            </Button>
                            <Button
                                Grid.Column="3"
                                Grid.Row="5"
                                Text="Creature 4"
                                Style="{StaticResource CreatureButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="creature4">
                            </Button>
                            <Button
                                Grid.Column="4"
                                Grid.Row="5"
                                Text="Creature 5"
                                Style="{StaticResource CreatureButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="creature5">
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <!--Right panel: Scarecrow up/down controls-->
                <Border
                    x:Name="ScarecrowPanel"
                    Grid.Column="1"
                    Grid.Row="1"
                    VerticalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SpookyOrangeLight}, Dark={StaticResource SpookyOrangeDark}}" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="10">
                    <Grid RowDefinitions="Auto,*">
                        <Picker
                            Grid.Row="0"
                            TextColor="White" FontSize="Medium" BackgroundColor="{AppThemeBinding Light={StaticResource SpookyPurpleLight}, Dark={StaticResource SpookyPurpleDark}}"
                            ItemsSource="{Binding HostList}" ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="PickerScareCrow_SelectedIndexChanged"
                        />
                        <Grid Grid.Row="1" RowSpacing="6" Margin="0,6,0,0"
                              RowDefinitions="*,*">
                            <Button
                                Grid.Row="0"
                                Text="&#9650;&#10;Up"
                                Style="{StaticResource ScarecrowButtonStyle}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                Command="{Binding SendScarecrowCommand}" CommandParameter="up">
                            </Button>
                            <Button
                                Grid.Row="1"
                                Text="&#9660;&#10;Down"
                                Style="{StaticResource ScarecrowButtonStyle}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                Command="{Binding SendScarecrowCommand}" CommandParameter="down">
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
