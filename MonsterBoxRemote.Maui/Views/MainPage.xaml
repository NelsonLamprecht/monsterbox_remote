<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MonsterBoxRemote.Maui.Views.MainPage"
    Title="Servers"
    BackgroundColor="#2bd011"
    >
    <ContentPage.Content>
        <StackLayout Padding="20" Spacing="10">
            <Label Text="Select an activity:" TextColor="Black" FontSize="Medium" Margin="0,0,0,10" />

            <Button x:Name="btnMonsterBox" Text="MonsterBox Controller"
                    Clicked="BtnMonsterBoxClicked"
                    HeightRequest="60"
                    TextColor="White" BackgroundColor="{StaticResource ButtonActive}" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
